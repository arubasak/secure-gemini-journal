# Local development only. NEVER commit a real .env.
# On Cloud Run these values come from Secret Manager via `--set-secrets` (see deploy.sh).

# Google Cloud project that owns Firebase, Firestore and Secret Manager
GOOGLE_CLOUD_PROJECT=your-project-id

# Gemini backend: "vertex" (default) uses Vertex AI via the service account - NO API key needed.
# Set to "aistudio" only if you want to use a Generative Language API key instead.
GEMINI_BACKEND=vertex
VERTEX_LOCATION=global

# Only needed when GEMINI_BACKEND=aistudio. Key from https://aistudio.google.com/apikey
# Leave EMPTY to have the server read it from Secret Manager (secret name: gemini-api-key)
GEMINI_API_KEY=

# Firebase web app config as ONE LINE of JSON (Firebase console -> Project settings -> Your apps -> SDK setup)
# Leave EMPTY to have the server read it from Secret Manager (secret name: firebase-web-config)
FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"your-project-id.firebaseapp.com","projectId":"your-project-id","appId":"1:...:web:..."}

# Optional: Google Maps Platform key (Geocoding API + Maps Static API) for location-aware entries
MAPS_API_KEY=

# Optional: public URL of the app, appended to Slack/Discord notifications
APP_URL=

# Optional tuning
GEMINI_MODEL=gemini-2.5-flash   # on vertex; use gemini-3.6-flash on aistudio
AI_RATE_LIMIT=40
REQUIRE_VERIFIED_EMAIL=false
PORT=8080
NODE_ENV=development
